cabal-version:      2.4
name:               codepilot-analyzer
version:            0.1.0.0
synopsis:           Deterministic code metrics engine for CodePilot
author:             CodePilot Team
build-type:         Simple

executable codepilot-analyzer
    main-is:          Main.hs
    other-modules:    Types
                    , Metrics
                    , Server
    build-depends:    base >= 4.14 && < 5
                    , scotty >= 0.12
                    , aeson >= 2.0
                    , text >= 1.2
                    , containers >= 0.6
                    , wai-extra >= 3.1
    hs-source-dirs:   app, src
    default-language: Haskell2010
    ghc-options:      -Wall -O2 -threaded -rtsopts